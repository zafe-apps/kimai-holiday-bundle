  <file source-language="en" target-language="de" datatype="plaintext" original="HolidayBundleFlash">
    <body>
      <trans-unit id="h000" resname="holiday.error.comment_required">
        <source>holiday.error.comment_required</source>
        <target>Für Abwesenheiten ist ein Kommentar erforderlich.</target>
      </trans-unit>
      <trans-unit id="h001" resname="holiday.error.month_locked">
        <source>holiday.error.month_locked</source>
        <target>Dieser Monat ist gesperrt und kann nicht geändert werden.</target>
      </trans-unit>
      <trans-unit id="h002" resname="holiday.error.timesheet_non_workday">
        <source>holiday.error.timesheet_non_workday</source>
        <target>Zeiteinträge sind auf vertragliche Arbeitstage beschränkt.</target>
      </trans-unit>
      <trans-unit id="h003" resname="holiday.error.ics_unknown_catalog">
        <source>holiday.error.ics_unknown_catalog</source>
        <target>Unbekannter Feiertagskalender.</target>
      </trans-unit>
      <trans-unit id="h004" resname="holiday.error.ics_invalid_url">
        <source>holiday.error.ics_invalid_url</source>
        <target>ICS-URL muss mit http:// oder https:// beginnen.</target>
      </trans-unit>
      <trans-unit id="h005" resname="holiday.error.ics_source_required">
        <source>holiday.error.ics_source_required</source>
        <target>Bitte einen Feiertagskalender wählen oder eine eigene ICS-URL angeben.</target>
      </trans-unit>
      <trans-unit id="h006" resname="holiday.error.ics_fetch_failed">
        <source>holiday.error.ics_fetch_failed</source>
        <target>ICS-Kalender konnte nicht geladen oder gelesen werden.</target>
      </trans-unit>
      <trans-unit id="h007" resname="holiday.error.ics_url_required">
        <source>holiday.error.ics_url_required</source>
        <target>Bitte eine eigene ICS-URL eingeben.</target>
      </trans-unit>
      <trans-unit id="h008" resname="holiday.error.ics_no_subscription">
        <source>holiday.error.ics_no_subscription</source>
        <target>Diese Feiertagsgruppe hat keine ICS-Subscription. Zuerst einen Kalender importieren.</target>
      </trans-unit>
      <trans-unit id="h009" resname="holiday.absence.edit.reapproval">
        <source>holiday.absence.edit.reapproval</source>
        <target>Abwesenheit aktualisiert. Sie muss erneut freigegeben werden, bevor sie zählt.</target>
      </trans-unit>
      <trans-unit id="h010" resname="holiday.absence.ics.regenerated">
        <source>holiday.absence.ics.regenerated</source>
        <target>Kalender-Link neu erzeugt. Bestehende Abonnements mit der neuen URL aktualisieren.</target>
      </trans-unit>
      <trans-unit id="h011" resname="holiday.error.invalid_date">
        <source>holiday.error.invalid_date</source>
        <target>Ungültiges Datum. Format JJJJ-MM-TT verwenden.</target>
      </trans-unit>
      <trans-unit id="h012" resname="holiday.error.end_before_start">
        <source>holiday.error.end_before_start</source>
        <target>Das Enddatum darf nicht vor dem Startdatum liegen.</target>
      </trans-unit>
      <trans-unit id="h013" resname="holiday.error.range_too_long">
        <source>holiday.error.range_too_long</source>
        <target>Eine Abwesenheit darf höchstens ein Jahr umfassen.</target>
      </trans-unit>
      <trans-unit id="h014" resname="holiday.error.invalid_duration">
        <source>holiday.error.invalid_duration</source>
        <target>Die Dauer muss zwischen 0 und 24 Stunden liegen.</target>
      </trans-unit>
      <trans-unit id="h015" resname="holiday.error.overlap">
        <source>holiday.error.overlap</source>
        <target>Diese Abwesenheit überschneidet sich mit einer bestehenden Abwesenheit.</target>
      </trans-unit>
      <trans-unit id="h020" resname="holiday.error.half_day_not_allowed">
        <source>holiday.error.half_day_not_allowed</source>
        <target>Halbe Urlaubstage sind nicht erlaubt.</target>
      </trans-unit>
      <trans-unit id="h016" resname="holiday.error.not_requested">
        <source>holiday.error.not_requested</source>
        <target>Nur beantragte Abwesenheiten können genehmigt oder abgelehnt werden.</target>
      </trans-unit>
      <trans-unit id="h017" resname="holiday.error.invalid_type">
        <source>holiday.error.invalid_type</source>
        <target>Unbekannte Abwesenheitsart.</target>
      </trans-unit>
      <trans-unit id="h018" resname="holiday.error.invalid_json">
        <source>holiday.error.invalid_json</source>
        <target>Ungültiger JSON-Request.</target>
      </trans-unit>
      <trans-unit id="h019" resname="holiday.error.invalid_comment">
        <source>holiday.error.invalid_comment</source>
        <target>Der Kommentar muss ein Text sein.</target>
      </trans-unit>
      <trans-unit id="h100" resname="holiday.error.self_approval">
        <source>holiday.error.self_approval</source>
        <target>Eigene Abwesenheiten können nicht selbst genehmigt werden. Das macht ein anderer Genehmiger.</target>
      </trans-unit>
      <trans-unit id="h101" resname="holiday.error.exception_times_incomplete">
        <source>holiday.error.exception_times_incomplete</source>
        <target>Bei Sonderöffnung beide Zeiten angeben.</target>
      </trans-unit>
      <trans-unit id="h102" resname="holiday.error.exception_exists">
        <source>holiday.error.exception_exists</source>
        <target>Für dieses Datum gibt es schon eine Ausnahme.</target>
      </trans-unit>
      <trans-unit id="h103" resname="holiday.error.group_in_use">
        <source>holiday.error.group_in_use</source>
        <target>Die Feiertagsgruppe wird von einem Standort verwendet und kann nicht gelöscht werden.</target>
      </trans-unit>
      <trans-unit id="h104" resname="holiday.error.extra_shift_exists">
        <source>holiday.error.extra_shift_exists</source>
        <target>Für diesen Tag gibt es schon eine Aushilfe.</target>
      </trans-unit>
      <trans-unit id="h105" resname="holiday.error.extra_shift_on_workday">
        <source>holiday.error.extra_shift_on_workday</source>
        <target>An einem Arbeitstag ist keine Aushilfe nötig.</target>
      </trans-unit>
      <trans-unit id="h106" resname="holiday.error.extra_shift_absent">
        <source>holiday.error.extra_shift_absent</source>
        <target>An diesem Tag ist eine genehmigte Abwesenheit eingetragen.</target>
      </trans-unit>
      <trans-unit id="h107" resname="holiday.error.extra_shift_closed">
        <source>holiday.error.extra_shift_closed</source>
        <target>Der Standort hat an diesem Tag geschlossen.</target>
      </trans-unit>
      <trans-unit id="h108" resname="holiday.extra_shift.created">
        <source>holiday.extra_shift.created</source>
        <target>Aushilfe eingetragen.</target>
      </trans-unit>
    </body>
  </file>
